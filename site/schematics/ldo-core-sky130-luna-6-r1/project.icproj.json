dde","name":"B"}]}],"simulationFolders":[],"source":{"dialect":"spice3f5-core","entry":"submitted.spice","files":[{"content":{"encoding":"utf-8","text":".subckt DUT VIN VOUT VSS VREF\n* Short-channel PMOS pass bank\nXMPASS VOUT gate VIN VIN sky130_fd_pr__pfet_01v8 w=100 l=0.15 m=5\n\n* Resistor-set PMOS bias and 10:1 tail current mirror\nXMPBIAS pbias pbias VIN VIN sky130_fd_pr__pfet_01v8 w=10 l=2\nRBIAS pbias VSS 400k\nXMPTAIL ptail pbias VIN VIN sky130_fd_pr__pfet_01v8 w=100 l=2\n\n* PMOS differential feedback pair with NMOS mirror load\nXMPREF ndref VREF ptail VIN sky130_fd_pr__pfet_01v8 w=45 l=0.5\nXMPFB a vfb ptail VIN sky130_fd_pr__pfet_01v8 w=45 l=0.5\nXNREF ndref ndref VSS VSS sky130_fd_pr__nfet_01v8 w=9 l=1\nXNOUT a ndref VSS VSS sky130_fd_pr__nfet_01v8 w=9 l=1\n\n* Class-A pass-gate driver: bias-mirrored PMOS source and error-controlled NMOS sink\nXMPUP gate pbias VIN VIN sky130_fd_pr__pfet_01v8 w=100 l=1.7\nXNDRIVE gate a VSS VSS sky130_fd_pr__nfet_01v8 w=50 l=1\n\n\n* Output feedback divider and Miller compensation with a series zero\nRTOP VOUT vfb 100k\nRBOT vfb VSS 100k\nRZ a cnode 36k\nCCOMP cnode gate 0.65p\n.ends DUT\n"},"hash":"sha256:fdabc8a6a5ca060912e760270c070ed665bd923fa256925bb5a0019c0c1ccf8b","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
