--\nXM1 NA VINN TAIL VSS sky130_fd_pr__nfet_01v8 W=100 L=1.5 nf=1 m=7\nXM2 NB VINP TAIL VSS sky130_fd_pr__nfet_01v8 W=100 L=1.5 nf=1 m=7\nXM3 NA NA VDD VDD sky130_fd_pr__pfet_01v8 W=50 L=0.5 nf=1 m=2\nXM4 NB NA VDD VDD sky130_fd_pr__pfet_01v8 W=50 L=0.5 nf=1 m=2\n* ---- output stage: PMOS common source ----\nXM6 VOUT NB VDD VDD sky130_fd_pr__pfet_01v8 W=100 L=0.25 nf=1 m=8\n* ---- Miller compensation ----\nRZ NB NZ 800\nCC NZ VOUT 19f\n.ends DUT\n"},"hash":"sha256:0c8c73785a4ffccbe3b6cd9b2c5b618ffb2edd07529a90b6f92f2e9efa45f16d","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
