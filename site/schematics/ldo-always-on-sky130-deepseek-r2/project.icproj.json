:"value","editor":"text","help":"Resistance","label":"Value","name":"value","placeholder":"1k","required":true,"unitHint":"Ohm"}],"pinOrder":["1","2"],"referencePrefix":"R","symbolId":"resistor","targetPolicy":"builtin"},"symbol":{"id":"resistor","name":"Resistor","pins":[{"at":{"x":0,"y":-20},"direction":"north","name":"1","presentation":{"leadLength":10,"visibility":"visible"},"role":"passive"},{"at":{"x":0,"y":20},"direction":"south","name":"2","presentation":{"leadLength":10,"visibility":"visible"},"role":"passive"}],"primitives":[{"bounds":{"height":40,"width":10.360465,"x":-4.988372,"y":-20},"data":"M 0 -20 L 0 -8.72093 L 5.372093 -6.395349 L -4.604651 -4.069767 L 5.372093 -1.162791 L -4.988372 1.744186 L 5.372093 4.651163 L -4.604651 7.55814 L 0 8.72093 L 0 20","kind":"path","style":{"lineCap":"butt","lineJoin":"miter","miterLimit":12,"strokeRole":"normal"}}],"schemaVersion":1,"variants":[],"viewBox":{"height":48,"width":20,"x":-10,"y":-24}}}],"externalSubcircuitDefinitions":[{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-27f716b14d59fc10","interfaceStatus":"declared","name":"sky130_fd_pr__pfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-7921a0096089118d","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-79219f0960890fda","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-79219e0960890e27","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-79219d0960890c74","name":"B"}]},{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-e5ee3d17d0c7c89a","interfaceStatus":"declared","name":"sky130_fd_pr__nfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-353df4da271bcc2b","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-353df3da271bca78","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-353df6da271bcf91","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-353df5da271bcdde","name":"B"}]}],"simulationFolders":[],"source":{"dialect":"spice3f5-core","entry":"submitted.spice","files":[{"content":{"encoding":"utf-8","text":"* LDO-ALWAYS-ON-SKY130 DUT v4\n* Small PMOS pass direct-driven by NMOS-input 5T OTA.\n* Tail = fixed NMOS sink (R/diode ref) + adaptive sink from pass-current sense.\n* Feedback: R divider with matched capacitive divider (no tap pole), VOUT/2 vs VREF.\n.subckt DUT VIN VOUT VSS VREF\n* --- pass device (PMOS, source at VIN, drain at VOUT, gate = OTA out) ---\nXMP1 VOUT G VIN VIN sky130_fd_pr__pfet_01v8 W=12 L=0.15\n* --- pass current sense (1:57) ---\nXMPS NS G VIN VIN sky130_fd_pr__pfet_01v8 W=0.42 L=0.3\n* --- sense diode and adaptive tail sink ---\nXMNS NS NS VSS VSS sky130_fd_pr__nfet_01v8 W=1 L=0.5\nXMNT STAIL NS VSS VSS sky130_fd_pr__nfet_01v8 W=2 L=0.5\n* --- fixed tail sink reference (R + diode) and mirror ---\nRF VIN NB 2e6\nXMND NB NB VSS VSS sky130_fd_pr__nfet_01v8 W=1 L=0.5\nXMNF STAIL NB VSS VSS sky130_fd_pr__nfet_01v8 W=1 L=0.5\n* --- OTA input pair (long channel for gain) ---\nXM1 D1 VFB STAIL VSS sky130_fd_pr__nfet_01v8 W=100 L=0.5\nXM2 G VREF STAIL VSS sky130_fd_pr__nfet_01v8 W=100 L=0.5\n* --- OTA PMOS mirror load ---\nXM3 D1 D1 VIN VIN sky130_fd_pr__pfet_01v8 W=6 L=1\nXM4 G D1 VIN VIN sky130_fd_pr__pfet_01v8 W=6 L=1\n* --- feedback divider with capacitive divider (ratio 1/2) ---\nR1 VOUT VFB 2e6\nR2 VFB VSS 2e6\nC1 VOUT VFB 2e-12\nC2 VFB VSS 2e-12\n.ends DUT\n"},"hash":"sha256:075c0027be1c16ccacee81dad91b27812bf8f2e1a1616cd0a3aee429af10f6c6","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
