XIP DN VINP NT VSS sky130_fd_pr__nfet_01v8 l=0.5 w=100 nf=1 m=10
XNC_L NM IBIAS NL VSS sky130_fd_pr__nfet_01v8 l=0.5 w=100 nf=1 m=2
XNC_R VOUT IBIAS NR VSS sky130_fd_pr__nfet_01v8 l=0.5 w=100 nf=1 m=2
