ght":48,"width":20,"x":-10,"y":-24}}}],"externalSubcircuitDefinitions":[{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-e5ee3d17d0c7c89a","interfaceStatus":"declared","name":"sky130_fd_pr__nfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-353df4da271bcc2b","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-353df3da271bca78","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-353df6da271bcf91","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-353df5da271bcdde","name":"B"}]},{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-27f716b14d59fc10","interfaceStatus":"declared","name":"sky130_fd_pr__pfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-7921a0096089118d","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-79219f0960890fda","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-79219e0960890e27","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-79219d0960890c74","name":"B"}]}],"simulationFolders":[],"source":{"dialect":"spice3f5-core","entry":"submitted.spice","files":[{"content":{"encoding":"utf-8","text":"* Continuous-time LDO, differential error amplifier with load-tracking bias\n.subckt DUT VIN VOUT VSS VREF\n* Slight setpoint centering balances finite-gain error over load and PVT.\nRFBT VOUT FB 2.015meg\nRFBB FB VSS 2meg\nCFF VOUT FB 1p\n* Low-current reference and NMOS bias mirror\nRB VIN BN 8meg\nXNB BN BN VSS VSS sky130_fd_pr__nfet_01v8 W=2 L=2 nf=1 m=1\nXNT TAIL BN VSS VSS sky130_fd_pr__nfet_01v8 W=6 L=2 nf=1 m=1\n* Bias increases with pass current\nXPA BA G VIN VIN sky130_fd_pr__pfet_01v8 W=0.5 L=0.75 nf=1 m=1\nXNA BA BA VSS VSS sky130_fd_pr__nfet_01v8 W=2 L=2 nf=1 m=1\nXNAT TAIL BA VSS VSS sky130_fd_pr__nfet_01v8 W=4 L=2 nf=1 m=1\n* NMOS differential input and PMOS mirror load\nXNF D FB TAIL VSS sky130_fd_pr__nfet_01v8 W=12 L=0.3 nf=1 m=1\nXNR G VREF TAIL VSS sky130_fd_pr__nfet_01v8 W=12 L=0.3 nf=1 m=1\nXPL D D VIN VIN sky130_fd_pr__pfet_01v8 W=0.5 L=0.5 nf=1 m=1\nXPR G D VIN VIN sky130_fd_pr__pfet_01v8 W=0.5 L=0.5 nf=1 m=1\n* PMOS series pass element\nXPP VOUT G VIN VIN sky130_fd_pr__pfet_01v8 W=30 L=0.5 nf=1 m=1\n.ends DUT\n"},"hash":"sha256:79dbe2a2420f79a0455a60888710e2462cfe7a30bed52c7f4dc296e9607962c9","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
