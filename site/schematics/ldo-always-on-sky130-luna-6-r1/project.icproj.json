ltValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-27f716b14d59fc10","interfaceStatus":"declared","name":"sky130_fd_pr__pfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-7921a0096089118d","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-79219f0960890fda","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-79219e0960890e27","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-79219d0960890c74","name":"B"}]}],"simulationFolders":[],"source":{"dialect":"spice3f5-core","entry":"submitted.spice","files":[{"content":{"encoding":"utf-8","text":".subckt DUT VIN VOUT VSS VREF\n* Low-current replica bias and NMOS differential error stage.\nRBIAS VIN NBIAS 1.4meg\nXBIAS NBIAS NBIAS VSS VSS sky130_fd_pr__nfet_01v8 W=4 L=1\nXTAIL NTAIL NBIAS VSS VSS sky130_fd_pr__nfet_01v8 W=4 L=1\nXINP NMIR FB NTAIL VSS sky130_fd_pr__nfet_01v8 W=8 L=1\nXINM NGATE VREF NTAIL VSS sky130_fd_pr__nfet_01v8 W=8 L=1\nXLOAD1 NMIR NMIR VIN VIN sky130_fd_pr__pfet_01v8 W=4 L=1\nXLOAD2 NGATE NMIR VIN VIN sky130_fd_pr__pfet_01v8 W=4 L=1\n* Quiet midpoint bias sets the active-discharge threshold.\n* Shunt conducts as the pass control rises on overvoltage.\n* PMOS high-side pass FET; ratio supports low-headroom heavy load.\nXPASS VOUT NGATE VIN VIN sky130_fd_pr__pfet_01v8 W=100 L=0.25 m=4\n* High-value feedback divider targets 1.2 V from the 0.6 V reference.\nRFB1 VOUT FB 10meg\nRFB2 FB VSS 10meg\n* Miller/feed-forward compensation across the pass device control path.\nCCOMP NGATE VOUT 1p\nCFF VOUT FB 1p\n.ends DUT\n"},"hash":"sha256:2cdc72f3571370f3e0fed34773037ba6909a0a1bcf80fffacecaa94b09e47407","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
