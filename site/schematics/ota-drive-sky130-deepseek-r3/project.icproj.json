tput swing)\nXm3 nA nA VDD VDD sky130_fd_pr__pfet_01v8 W=100 L=1 nf=1 m=5\nXm4 nC nA VDD VDD sky130_fd_pr__pfet_01v8 W=100 L=1 nf=1 m=5\nXm4c VOUT nBias nC VDD sky130_fd_pr__pfet_01v8 W=100 L=1 nf=1 m=5\n* cascode gate bias from IBIAS diode node (divider ~0.23uA)\nR1 IBIAS nBias 1MEG\nR2 nBias VSS 1.3MEG\n.ends DUT\n"},"hash":"sha256:0e470a2cdd3dd289f4b87c3155ac03bcda6975490439e3f0b97f4641de84350c","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
