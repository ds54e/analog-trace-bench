"kind":"path","style":{"lineCap":"butt","lineJoin":"miter","miterLimit":12,"strokeRole":"normal"}}],"schemaVersion":1,"variants":[],"viewBox":{"height":48,"width":20,"x":-10,"y":-24}}}],"externalSubcircuitDefinitions":[{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-27f716b14d59fc10","interfaceStatus":"declared","name":"sky130_fd_pr__pfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-7921a0096089118d","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-79219f0960890fda","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-79219e0960890e27","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-79219d0960890c74","name":"B"}]},{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-e5ee3d17d0c7c89a","interfaceStatus":"declared","name":"sky130_fd_pr__nfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-353df4da271bcc2b","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-353df3da271bca78","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-353df6da271bcf91","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-353df5da271bcdde","name":"B"}]}],"simulationFolders":[],"source":{"dialect":"spice3f5-core","entry":"submitted.spice","files":[{"content":{"encoding":"utf-8","text":"* LDO final (best measured): PMOS pass with direct gate drive, PMOS diff pair with\n* current-source tail, NMOS mirror load, series-RC (nulling-resistor) Miller compensation,\n* low-impedance 1:1 feedback divider.  Pair L=0.25 suppresses DIBL load-dependent offset.\n.subckt DUT VIN VOUT VSS VREF\n* --- pass device (source=VIN, gate=G, drain=VOUT) ---\nXMP VOUT G VIN VIN sky130_fd_pr__pfet_01v8 W=100 L=0.15 nf=1 m=3\n* --- input pair: M1 gate=VFB (left, mirror side), M2 gate=VREF (right -> gate node) ---\nXM1 D1 VFB S VIN sky130_fd_pr__pfet_01v8 W=50 L=0.25 nf=1 m=1\nXM2 G VREF S VIN sky130_fd_pr__pfet_01v8 W=50 L=0.25 nf=1 m=1\n* --- tail PMOS current source (mirror of bias leg) ---\nXMT S VB VIN VIN sky130_fd_pr__pfet_01v8 W=50 L=0.5 nf=1 m=1\nXMB VB VB VIN VIN sky130_fd_pr__pfet_01v8 W=50 L=0.5 nf=1 m=1\nRB VB VSS 12k\n* --- NMOS mirror load ---\nXM3 D1 D1 VSS VSS sky130_fd_pr__nfet_01v8 W=20 L=0.5 nf=1 m=1\nXM4 G D1 VSS VSS sky130_fd_pr__nfet_01v8 W=20 L=0.5 nf=1 m=1\n* --- compensation: Miller cap with series nulling resistor ---\nCC G NC1 20p\nRC NC1 VOUT 10k\n* --- feedback divider (1:1, low impedance: fast loop, small gate swing) ---\nR1 VOUT VFB 7.5k\nR2 VFB VSS 7.5k\n.ends DUT\n"},"hash":"sha256:61ef4f1178aca058a42928854106a6143258cbb13d7e478f627ff12dc3502e65","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
