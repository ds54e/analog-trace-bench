AIL VSS sky130_fd_pr__nfet_01v8 w=100 l=0.5 nf=1 m=1\n* Matched PMOS current-mirror load\nXLOAD1 ND1 ND1 VDD VDD sky130_fd_pr__pfet_01v8 w=75 l=1 nf=1 m=2\nXLOAD2 ND2 ND1 VDD VDD sky130_fd_pr__pfet_01v8 w=75 l=1 nf=1 m=2\n* Common-source PMOS output stage; 1 mA sink mirror for load drive\nXOUTP VOUT ND2 VDD VDD sky130_fd_pr__pfet_01v8 w=100 l=0.5 nf=1 m=32\nXOUTP2 VOUT ND2 VDD VDD sky130_fd_pr__pfet_01v8 w=100 l=0.5 nf=1 m=8\n* Miller compensation with a series nulling resistor\nRZ ND2 XCOMP 800\nCC XCOMP VOUT 8.5p\n.ends DUT\n"},"hash":"sha256:f816d903d46e8f187147af43b9e2f8193362526110e24d64b16d50601526d614","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
