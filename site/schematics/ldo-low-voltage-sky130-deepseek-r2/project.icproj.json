,"placeholder":"1k","required":true,"unitHint":"Ohm"}],"pinOrder":["1","2"],"referencePrefix":"R","symbolId":"resistor","targetPolicy":"builtin"},"symbol":{"id":"resistor","name":"Resistor","pins":[{"at":{"x":0,"y":-20},"direction":"north","name":"1","presentation":{"leadLength":10,"visibility":"visible"},"role":"passive"},{"at":{"x":0,"y":20},"direction":"south","name":"2","presentation":{"leadLength":10,"visibility":"visible"},"role":"passive"}],"primitives":[{"bounds":{"height":40,"width":10.360465,"x":-4.988372,"y":-20},"data":"M 0 -20 L 0 -8.72093 L 5.372093 -6.395349 L -4.604651 -4.069767 L 5.372093 -1.162791 L -4.988372 1.744186 L 5.372093 4.651163 L -4.604651 7.55814 L 0 8.72093 L 0 20","kind":"path","style":{"lineCap":"butt","lineJoin":"miter","miterLimit":12,"strokeRole":"normal"}}],"schemaVersion":1,"variants":[],"viewBox":{"height":48,"width":20,"x":-10,"y":-24}}}],"externalSubcircuitDefinitions":[{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-27f716b14d59fc10","interfaceStatus":"declared","name":"sky130_fd_pr__pfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-7921a0096089118d","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-79219f0960890fda","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-79219e0960890e27","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-79219d0960890c74","name":"B"}]},{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-e5ee3d17d0c7c89a","interfaceStatus":"declared","name":"sky130_fd_pr__nfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-353df4da271bcc2b","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-353df3da271bca78","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-353df6da271bcf91","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-353df5da271bcdde","name":"B"}]}],"simulationFolders":[],"source":{"dialect":"spice3f5-core","entry":"submitted.spice","files":[{"content":{"encoding":"utf-8","text":"* LDO-LOW-VOLTAGE-SKY130\n* PMOS pass device, 5T PMOS-input error amp with NMOS mirror,\n* reference and feedback scaled x2/x4, Miller+feedforward cap GA->VOUT,\n* resistor-diode bias, resistive preload.\n.subckt DUT VIN VOUT VSS VREF\n\n* --- pass device (effective W/L ~ 21300) ---\nXMP0 VOUT GA VIN VIN sky130_fd_pr__pfet_01v8 w=100 l=0.15 nf=1 m=32\n\n* --- compensation / feedforward ---\nCC GA VOUT 30p\n\n* --- feedback divider : VOUT/4 ---\nRFA VOUT FB 600k\nRFB FB VSS 200k\n\n* --- reference divider : VREF/2 ---\nRVA VREF VR 1meg\nRVB VR VSS 1meg\n\n* --- error amp : PMOS pair (sources at S1) + NMOS mirror load ---\nXM1 D1 FB VIN VIN sky130_fd_pr__pfet_01v8 w=20 l=0.5 nf=1 m=1\nXM2 GA VR VIN VIN sky130_fd_pr__pfet_01v8 w=20 l=0.5 nf=1 m=1\nXM3 D1 D1 VSS VSS sky130_fd_pr__nfet_01v8 w=20 l=0.5 nf=1 m=1\nXM4 GA D1 VSS VSS sky130_fd_pr__nfet_01v8 w=20 l=0.5 nf=1 m=1\n\n* --- bias : diode PMOS + resistor ; tail current source ---\nRB NB VSS 200k\nXM6 NB NB VIN VIN sky130_fd_pr__pfet_01v8 w=20 l=0.5 nf=1 m=1\nXM5 S1 NB VIN VIN sky130_fd_pr__pfet_01v8 w=20 l=0.5 nf=1 m=8\n\n* --- preload ---\nRL VOUT VSS 20k\n\n.ends DUT\n"},"hash":"sha256:3cc416e20b5890f83bdf831c12e0550453231a51b8979df3b56ba509bbfe0634","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
