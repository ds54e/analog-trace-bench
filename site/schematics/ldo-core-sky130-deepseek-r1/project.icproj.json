0465,"x":-4.988372,"y":-20},"data":"M 0 -20 L 0 -8.72093 L 5.372093 -6.395349 L -4.604651 -4.069767 L 5.372093 -1.162791 L -4.988372 1.744186 L 5.372093 4.651163 L -4.604651 7.55814 L 0 8.72093 L 0 20","kind":"path","style":{"lineCap":"butt","lineJoin":"miter","miterLimit":12,"strokeRole":"normal"}}],"schemaVersion":1,"variants":[],"viewBox":{"height":48,"width":20,"x":-10,"y":-24}}}],"externalSubcircuitDefinitions":[{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-27f716b14d59fc10","interfaceStatus":"declared","name":"sky130_fd_pr__pfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-7921a0096089118d","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-79219f0960890fda","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-79219e0960890e27","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-79219d0960890c74","name":"B"}]},{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-e5ee3d17d0c7c89a","interfaceStatus":"declared","name":"sky130_fd_pr__nfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-353df4da271bcc2b","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-353df3da271bca78","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-353df6da271bcf91","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-353df5da271bcdde","name":"B"}]}],"simulationFolders":[],"source":{"dialect":"spice3f5-core","entry":"submitted.spice","files":[{"content":{"encoding":"utf-8","text":"* LDO core: single-stage 5T OTA (NMOS input pair, PMOS mirror load) driving\n* a PMOS pass device. Miller compensation Cc=12p with series nulling resistor\n* RZ=25k (LHP zero). Bias: VOUT-referenced resistor + diode, mirrored 1:20.\n.subckt DUT VIN VOUT VSS VREF\n* --- pass device (PMOS, source at VIN) ---\nXMP VOUT VG VIN VIN sky130_fd_pr__pfet_01v8 w=100 l=0.15 m=5\n* --- error amp input pair (NMOS), FB on non-inverting (mirror-diode) side ---\nXM1 A1 VFB VS1 VSS sky130_fd_pr__nfet_01v8 w=100 l=0.5\nXM2 VG VREF VS1 VSS sky130_fd_pr__nfet_01v8 w=100 l=0.5\n* --- tail current mirror ---\nXM5 VS1 NB VSS VSS sky130_fd_pr__nfet_01v8 w=100 l=1 m=20\n* --- PMOS mirror load ---\nXM3 A1 A1 VIN VIN sky130_fd_pr__pfet_01v8 w=30 l=1\nXM4 VG A1 VIN VIN sky130_fd_pr__pfet_01v8 w=30 l=1\n* --- bias: VOUT-referenced resistor + diode ---\nXM7 NB NB VSS VSS sky130_fd_pr__nfet_01v8 w=100 l=1\nRB VOUT NB 320k\n* --- start-up / gate pulldown ---\nRST VG VSS 10meg\n* --- feedback divider ---\nR1D VOUT VFB 300k\nR2D VFB VSS 300k\n* --- Miller compensation with nulling resistor ---\nCC VG NC1 12p\nRZ NC1 VOUT 25k\n.ends DUT\n"},"hash":"sha256:44a466fdea2e8a04ed0128959e368ea2a2c121e6a41cfa7ac33436b91eb55335","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
