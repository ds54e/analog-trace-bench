lue":"1","name":"m"}],"id":"external-subcircuit-27f716b14d59fc10","interfaceStatus":"declared","name":"sky130_fd_pr__pfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-7921a0096089118d","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-79219f0960890fda","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-79219e0960890e27","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-79219d0960890c74","name":"B"}]}],"simulationFolders":[],"source":{"dialect":"spice3f5-core","entry":"submitted.spice","files":[{"content":{"encoding":"utf-8","text":"* Two-stage compensated CMOS OTA. IBIAS is sunk by the diode-connected N reference.\n.subckt DUT VINP VINN VOUT VDD VSS IBIAS\n* 10 uA reference, 37x tail mirror and 105x output sink mirror.\nXNR IBIAS IBIAS VSS VSS sky130_fd_pr__nfet_01v8 W=16 L=1 m=1\nXNT TAIL IBIAS VSS VSS sky130_fd_pr__nfet_01v8 W=74 L=1 m=8\nXNS VOUT IBIAS VSS VSS sky130_fd_pr__nfet_01v8 W=70 L=1 m=24\n* NMOS differential pair; the VINN side is the diode-load side for correct loop polarity.\nXNI NDI VINN TAIL VSS sky130_fd_pr__nfet_01v8 W=100 L=0.15 m=1\nXNP NOUT VINP TAIL VSS sky130_fd_pr__nfet_01v8 W=100 L=0.15 m=1\n* PMOS current mirror load, 300 um / 0.5 um per side.\nXPL NDI NDI VDD VDD sky130_fd_pr__pfet_01v8 W=100 L=0.5 m=3\nXPR NOUT NDI VDD VDD sky130_fd_pr__pfet_01v8 W=100 L=0.5 m=3\n* PMOS common-source output balances the 1.05 mA sink at quiescence.\nXPO VOUT NOUT VDD VDD sky130_fd_pr__pfet_01v8 W=71 L=0.5 m=24\n* Miller compensation with a series lead zero.\nRZ NOUT NCOMP 420\nCC NCOMP VOUT 20p\n.ends DUT\n"},"hash":"sha256:7cee7ec10489b05070e0d29a1400fa0470205ffd2b272f912c6dcdf5f7a727ec","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
