XM3 F1 VBP VDD VDD sky130_fd_pr__pfet_01v8 W=100 L=0.25 nf=1 m=5
XM4 F2 VBP VDD VDD sky130_fd_pr__pfet_01v8 W=100 L=0.25 nf=1 m=5
XM5 VOUT VBC F1 VDD sky130_fd_pr__pfet_01v8 W=50 L=0.5 nf=1 m=8
XM6 C2 VBC F2 VDD sky130_fd_pr__pfet_01v8 W=50 L=0.5 nf=1 m=8
XM1 F1 VINN TAIL VSS sky130_fd_pr__nfet_01v8 W=100 L=0.25 nf=1 m=12
