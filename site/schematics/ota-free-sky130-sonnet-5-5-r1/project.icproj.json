=4\nXM7 VOUT IBIAS VSS VSS sky130_fd_pr__nfet_01v8 W=4 L=1 nf=1 m=16\n* compensation\nCC O1 NZ 2.2p\nRZ NZ VOUT 1900\n.ends DUT\n"},"hash":"sha256:c90dac4f170360856dfdc4e93174bde1a1c165c912c98e662292ac8c97c5fd18","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
