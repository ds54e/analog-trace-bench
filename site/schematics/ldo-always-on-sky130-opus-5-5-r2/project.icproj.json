-353df3da271bca78","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-353df6da271bcf91","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-353df5da271bcdde","name":"B"}]},{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-27f716b14d59fc10","interfaceStatus":"declared","name":"sky130_fd_pr__pfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-7921a0096089118d","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-79219f0960890fda","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-79219e0960890e27","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-79219d0960890c74","name":"B"}]}],"simulationFolders":[],"source":{"dialect":"spice3f5-core","entry":"submitted.spice","files":[{"content":{"encoding":"utf-8","text":"* Always-on LDO, sky130\n* Single-stage NMOS-input OTA directly drives a small PMOS pass device.\n* Output-pole-dominant compensation by the external 10-100 nF capacitor;\n* small pass gate capacitance keeps the gate pole well above the loop UGF.\n.subckt DUT VIN VOUT VSS VREF\n* fixed bias reference: resistor from VIN into NMOS diode (~0.1 uA)\nRB VIN NB 10meg\nXMNB NB NB VSS VSS sky130_fd_pr__nfet_01v8 W=1 L=2 nf=1 m=1\n* tail current source (4x reference)\nXMT1 TAIL NB VSS VSS sky130_fd_pr__nfet_01v8 W=1 L=2 nf=1 m=4\n* error amplifier: FB on diode side, VREF on output side\nXM1 D1 FB TAIL VSS sky130_fd_pr__nfet_01v8 W=20 L=0.5 nf=1 m=1\nXM2 G VREF TAIL VSS sky130_fd_pr__nfet_01v8 W=20 L=0.5 nf=1 m=1\nXM3 D1 D1 VIN VIN sky130_fd_pr__pfet_01v8 W=1 L=0.5 nf=1 m=1\nXM4 G D1 VIN VIN sky130_fd_pr__pfet_01v8 W=1 L=0.5 nf=1 m=1\n* pass device\nXMP VOUT G VIN VIN sky130_fd_pr__pfet_01v8 W=15 L=0.15 nf=1 m=1\n* feedback divider, ratio trimmed to centre the systematic OTA offset\nRT VOUT FB 1.9844meg\nRBOT FB VSS 2meg\nCFF VOUT FB 100f\n.ends DUT\n"},"hash":"sha256:206ae333350c120e01396117592325f72add3063d7ba5878b6b368694f797a90","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
