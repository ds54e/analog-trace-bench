:"normal"},"to":{"x":-4.607544,"y":0}}],"schemaVersion":1,"variants":[],"viewBox":{"height":14,"width":18,"x":-14,"y":-7}}},{"electrical":{"capabilities":{"supportsBulkBinding":false,"supportsModel":false,"supportsValueAnnotation":true},"deviceClass":"resistor","dialects":["spice","spectre"],"id":"resistor","parameters":[{"defaultValue":"1k","displayRole":"value","editor":"text","help":"Resistance","label":"Value","name":"value","placeholder":"1k","required":true,"unitHint":"Ohm"}],"pinOrder":["1","2"],"referencePrefix":"R","symbolId":"resistor","targetPolicy":"builtin"},"symbol":{"id":"resistor","name":"Resistor","pins":[{"at":{"x":0,"y":-20},"direction":"north","name":"1","presentation":{"leadLength":10,"visibility":"visible"},"role":"passive"},{"at":{"x":0,"y":20},"direction":"south","name":"2","presentation":{"leadLength":10,"visibility":"visible"},"role":"passive"}],"primitives":[{"bounds":{"height":40,"width":10.360465,"x":-4.988372,"y":-20},"data":"M 0 -20 L 0 -8.72093 L 5.372093 -6.395349 L -4.604651 -4.069767 L 5.372093 -1.162791 L -4.988372 1.744186 L 5.372093 4.651163 L -4.604651 7.55814 L 0 8.72093 L 0 20","kind":"path","style":{"lineCap":"butt","lineJoin":"miter","miterLimit":12,"strokeRole":"normal"}}],"schemaVersion":1,"variants":[],"viewBox":{"height":48,"width":20,"x":-10,"y":-24}}}],"externalSubcircuitDefinitions":[{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-e5ee3d17d0c7c89a","interfaceStatus":"declared","name":"sky130_fd_pr__nfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-353df4da271bcc2b","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-353df3da271bca78","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-353df6da271bcf91","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-353df5da271bcdde","name":"B"}]},{"formalParameters":[{"defaultValue":"1","name":"w"},{"defaultValue":"0.15","name":"l"},{"defaultValue":"1","name":"nf"},{"defaultValue":"1","name":"m"}],"id":"external-subcircuit-27f716b14d59fc10","interfaceStatus":"declared","name":"sky130_fd_pr__pfet_01v8","terminals":[{"direction":"passive","id":"external-subcircuit-terminal-7921a0096089118d","name":"D"},{"direction":"passive","id":"external-subcircuit-terminal-79219f0960890fda","name":"G"},{"direction":"passive","id":"external-subcircuit-terminal-79219e0960890e27","name":"S"},{"direction":"passive","id":"external-subcircuit-terminal-79219d0960890c74","name":"B"}]}],"simulationFolders":[],"source":{"dialect":"spice3f5-core","entry":"submitted.spice","files":[{"content":{"encoding":"utf-8","text":"* ATB OTA-SKY130 DUT -- two-stage Miller-compensated OTA on SKY130 1.8 V devices\n*\n* Topology: M1/M2 are the NMOS differential pair with common source ntl.\n* M3 is the diode-connected PMOS load at na; M4 mirrors it into n1.  M7 is\n* the PMOS second stage (source vdd, gate n1, drain vout), loaded by the\n* NMOS current sink M8 (drain vout, source vss).  Diode-connected Mbn accepts\n* ibias; its gate also biases the NMOS tail device Mtl and M8.\n* Miller compensation connects n1 to vout through Cc and optional series Rz.\n* For rz = 0, render_dut connects Cc directly to vout and omits Rz.\n* The netlist below is authoritative.  docs/figures/ota-sky130.svg and the\n* editable project in circuits/ota-sky130/schematic/ are derived documentation,\n* not sizing or evaluation sources.\n*\n* Static polarity (large-signal, checked in bench tb_dc):\n*   A rise on vin_p raises the M2 current and lowers the M4 current; node n1\n*   falls; the PMOS M7 gate falls, so M7 sources more current and vout rises.\n*   Hence vin_p is the NON-inverting input and vin_n (gate of M1, whose drain\n*   is the diode-connected node na) is the inverting input of the complete\n*   two-stage amplifier.\n*\n* SKY130 devices are PDK subcircuits, so every device below is an X instance.\n* Body terminals are tied to the supply rails; there is no separate bulk port\n* in P0.  The DUT contains no behavioural source.\n*\n.subckt atb_ota_sky130 vin_p vin_n vout vdd vss ibias\nXMbn ibias ibias vss  vss sky130_fd_pr__nfet_01v8 w=7.2 l=1 nf=1\nXMtl ntl   ibias vss  vss sky130_fd_pr__nfet_01v8 w=43.2 l=1 nf=1\nXM1  na    vin_n ntl  vss sky130_fd_pr__nfet_01v8 w=72 l=1.2 nf=1\nXM2  n1    vin_p ntl  vss sky130_fd_pr__nfet_01v8 w=72 l=1.2 nf=1\nXM3  na    na    vdd  vdd sky130_fd_pr__pfet_01v8 w=20 l=0.5 nf=1\nXM4  n1    na    vdd  vdd sky130_fd_pr__pfet_01v8 w=20 l=0.5 nf=1\nXM7  vout  n1    vdd  vdd sky130_fd_pr__pfet_01v8 w=100 l=0.5 nf=1\nXM8  vout  ibias vss  vss sky130_fd_pr__nfet_01v8 w=100 l=1 nf=1\nCc   n1    nzc    3.5e-12\nRz   nzc   vout   1500\n.ends atb_ota_sky130\n"},"hash":"sha256:733483a684da5f21ef7aef4d9c92e57b7b5efddf7039f92fbe977050af60e0c6","id":"source-c64c2f6b688cd548","path":"submitted.spice"}],"sourcePolicy":"copy"},"symbolLibrary":{"hash":"razavi-reference-v1","id":"razavi-symbols","version":"1"},"structureRevision":0}
